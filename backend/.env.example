PORT=3000
# MongoDB Atlas Connection String (Replica Set by default with Change Streams enabled)
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ipl_updates?retryWrites=true&w=majority
JWT_SECRET=super-secret-ipl-jwt-key-2026-secure
JWT_EXPIRES_IN=2h
